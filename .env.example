# ---- Contact form (optional but recommended) ----
# The contact form posts to /api/contact, which sends email via Resend.
# Sign up free at https://resend.com, create an API key, and add it in Vercel:
#   Project -> Settings -> Environment Variables
#
# If these are not set, the form still validates but returns a friendly
# "email isn't wired up yet" message instead of sending.

# Your Resend API key (starts with "re_")
RESEND_API_KEY=

# Where contact-form submissions are delivered
CONTACT_TO_EMAIL=contact@ecosanskritiinnovations.co.in

# The "from" address. Until you verify your domain in Resend, you can use
# the Resend sandbox sender: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
